From 53b62da1649e6e1d1fd33fa545c897935b5459b9 Mon Sep 17 00:00:00 2001
From: vishwajithkv <vishwajithkv@users.noreply.github.com>
Date: Thu, 8 Oct 2026 21:58:18 +0530
Subject: [PATCH] pil-squasher: use supported Soong host dependency API

---
 pil-squasher/soong/pil_squasher.go | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/pil-squasher/soong/pil_squasher.go b/pil-squasher/soong/pil_squasher.go
index 7ca12b8..75878ff 100644
--- a/pil-squasher/soong/pil_squasher.go
+++ b/pil-squasher/soong/pil_squasher.go
@@ -8,6 +8,7 @@ package pil_squasher
 import (
 	"regexp"
 
+	"github.com/google/blueprint"
 	"github.com/google/blueprint/proptools"
 
 	"android/soong/android"
@@ -16,6 +17,7 @@ import (
 var (
 	pctx           = android.NewPackageContext("android/soong/pil_squasher")
 	chunkExtRegexp = regexp.MustCompile(`^\.b[0-9]{2}$`)
+	hostToolDepTag = blueprint.BaseDependencyTag{}
 )
 
 func init() {
@@ -201,5 +203,7 @@ func (p *pilSquasher) AndroidMkEntries() []android.AndroidMkEntries {
 }
 
 func (p *pilSquasher) DepsMutator(ctx android.BottomUpMutatorContext) {
-	ctx.AddHostToolDependencies("pil-squasher")
+	// This Soong version resolves host tools through the build-OS variant.
+	ctx.AddFarVariationDependencies(ctx.Config().BuildOSTarget.Variations(),
+		hostToolDepTag, "pil-squasher")
 }
-- 

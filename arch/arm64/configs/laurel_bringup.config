# SPDX-License-Identifier: GPL-2.0-only
# Merge last, after laurel_pmos_defconfig and both existing Android/Mi A3 fragments.

# Bootloader framebuffer; software rendering avoids Adreno firmware dependency.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
# Keep DRM/fbdev for Android and recovery, without a competing text console.
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# CONFIG_DRM_MSM is not set
# CONFIG_SM_DISPCC_6125 is not set
# CONFIG_SM_GPUCC_6125 is not set
# CONFIG_DRM_PANEL_SAMSUNG_S6E8FCO is not set

# Keep PMIC thermal monitoring built in with the existing thermal DT nodes.
CONFIG_IIO=y
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_QCOM_SPMI_ADC_TM5=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y

# FT3518 touch and its GENI/GPI transport are needed in recovery as well.
CONFIG_TOUCHSCREEN_EDT_FT5X06=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_QCOM_GENI_SE=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# Other optional hardware stays out of the bringup kernel profile.
# CONFIG_MMC is not set
CONFIG_RTC_DRV_PM8XXX=y
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_SND is not set
# CONFIG_BT is not set
# CONFIG_WLAN is not set
# SM6125 MPSS uses PAS (not the self-authenticating MSS loader).
# Keep dependencies built in for normal Android and recovery diagnostics.
CONFIG_REMOTEPROC=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_Q6V5_COMMON=y
CONFIG_QCOM_RPROC_COMMON=y
CONFIG_QCOM_MDT_LOADER=y
CONFIG_QCOM_PIL_INFO=y
CONFIG_QCOM_SYSMON=y
CONFIG_QCOM_PD_MAPPER=y
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_QCOM_RMTFS_MEM=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMP2P=y
CONFIG_RPMSG=y
CONFIG_RPMSG_QCOM_GLINK=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
# Other DSPs and WLAN remain outside the modem bringup stage.
# CONFIG_QCOM_Q6V5_ADSP is not set
# CONFIG_QCOM_Q6V5_MSS is not set
# CONFIG_QCOM_Q6V5_WCSS is not set
# CONFIG_QCOM_WCNSS_PIL is not set
# CONFIG_QCOM_FASTRPC is not set
# CONFIG_QCOM_IPA is not set

# Use the established C memfd compatibility path with Lineage's LLVM tools.
# CONFIG_RUST is not set
# CONFIG_ASHMEM is not set
CONFIG_MEMFD_CREATE=y
CONFIG_MEMFD_ASHMEM_SHIM=y

# Preserve the fbdev interface used by recovery's graphics backend.
CONFIG_DRM_CLIENT_DEFAULT_FBDEV=y
# CONFIG_DRM_CLIENT_LOG is not set

# Real PMI632 battery and USB charger telemetry in Android and recovery.
CONFIG_POWER_SUPPLY=y
CONFIG_CHARGER_QCOM_PMI632=y
CONFIG_BATTERY_QCOM_PMI632_QG=y
CONFIG_NVMEM_SPMI_SDAM=y

CONFIG_CHARGER_QCOM_SMB1355=y

# SPDX-License-Identifier: GPL-2.0-only
# Merge last, after laurel_pmos_defconfig and both existing Android/Mi A3 fragments.

# Bootloader framebuffer; software rendering avoids Adreno firmware dependency.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# CONFIG_DRM_MSM is not set
# CONFIG_SM_DISPCC_6125 is not set
# CONFIG_SM_GPUCC_6125 is not set
# CONFIG_DRM_PANEL_SAMSUNG_S6E8FCO is not set

# Keep PMIC thermal monitoring built in with the existing thermal DT nodes.
CONFIG_IIO=y
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_QCOM_SPMI_ADC_TM5=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y

# Optional hardware stays out of the first-boot kernel profile.
# CONFIG_TOUCHSCREEN_EDT_FT5X06 is not set
# CONFIG_MMC is not set
# CONFIG_RTC_DRV_PM8XXX is not set
# CONFIG_QCOM_GPI_DMA is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_SND is not set
# CONFIG_BT is not set
# CONFIG_WLAN is not set
# CONFIG_REMOTEPROC is not set
# CONFIG_QCOM_FASTRPC is not set
# CONFIG_QCOM_IPA is not set
# CONFIG_QCOM_RMTFS_MEM is not set

# Use the established C memfd compatibility path with Lineage's LLVM tools.
# CONFIG_RUST is not set
# CONFIG_ASHMEM is not set
CONFIG_MEMFD_CREATE=y
CONFIG_MEMFD_ASHMEM_SHIM=y

# Preserve fbcon recovery diagnostics and the existing vtconsole handover.
CONFIG_DRM_CLIENT_DEFAULT_FBDEV=y
# CONFIG_DRM_CLIENT_LOG is not set

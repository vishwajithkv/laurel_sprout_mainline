# SPDX-License-Identifier: GPL-2.0-only
# Mi A3 fixups: merge after defconfig and android-mainline.config.

# Android Binder and memfd
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
# ACK 6.18 Binder depends on EVENT_TRACING. A user-visible tracer selects it.
CONFIG_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_MEMFD_CREATE=y
CONFIG_MEMFD_ASHMEM_SHIM=y

# Boot storage: no module loading is needed to reach Android partitions.
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_RESET_CONTROLLER=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y

# Clocks, pin control, PMIC, power domains, and shared memory
CONFIG_ARCH_QCOM=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_SM_GCC_6125=y
CONFIG_QCOM_CLK_SMD_RPM=y
CONFIG_PINCTRL_MSM=y
CONFIG_PINCTRL_SM6125=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_QCOM_SMD_RPM=y
CONFIG_REGULATOR_QCOM_SPMI=y
CONFIG_QCOM_SCM=y
CONFIG_HWSPINLOCK=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_MAILBOX=y
CONFIG_RPMSG=y
CONFIG_RPMSG_QCOM_GLINK_RPM=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_QCOM_RPMPD=y
CONFIG_NVMEM=y
CONFIG_NVMEM_QCOM_QFPROM=y
CONFIG_ARM_SMMU=y

# Display and touch modules; simpledrm provides the bootloader framebuffer.
CONFIG_FIRMWARE_IN_KERNEL=y
CONFIG_EXTRA_FIRMWARE="qcom/a630_sqe.fw qcom/sm6125/xiaomi/laurel/a610_zap.mbn"
CONFIG_EXTRA_FIRMWARE_DIR="firmware"
CONFIG_DRM=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_MSM=m
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_14NM_PHY=y
CONFIG_SM_DISPCC_6125=m
CONFIG_SM_GPUCC_6125=m
CONFIG_DRM_PANEL_SAMSUNG_S6E8FCO=m
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=m
CONFIG_I2C=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_QCOM_GENI_SE=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_PM8941_PWRKEY=y

# Filesystem security labels are required for Android userdata.
CONFIG_F2FS_FS_SECURITY=y

# Modules remain uncompressed for Android module collection.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_MODULE_COMPRESS is not set
# CONFIG_MODULE_SIG_ALL is not set

# Persistent boot logs, using the existing DTS ramoops reservation.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# USB and Type-C are built in so ADB does not depend on vendor modules.
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_EXTCON=y
CONFIG_EXTCON_USB_GPIO=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_QCOM_PMIC=y
CONFIG_REGULATOR_QCOM_USB_VBUS=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_ANDROID_USB_CONFIGFS_UEVENT=y

# ARM64 uses 4 KiB pages for this first Android port.
CONFIG_ARM64_4K_PAGES=y
# CONFIG_ARM64_16K_PAGES is not set
# CONFIG_ARM64_64K_PAGES is not set

# Recovery and normal Android use the same built-in filesystems/UFS UAPI.
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_F2FS_FS=y
# ACK's F2FS vendor hook requires read_waiters, supplied by this GKI option.
CONFIG_BLK_CGROUP=y
CONFIG_F2FS_UNFAIR_RWSEM=y
CONFIG_SCSI_UFS_BSG=y
CONFIG_CHR_DEV_SG=y
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_BLK_INLINE_ENCRYPTION_FALLBACK=y
